            local c=LocalPlayer.Character; if not c then return end
            local hrp2=c:FindFirstChild("HumanoidRootPart"); if not hrp2 then return end
            local cam=workspace.CurrentCamera; local lv=cam.CFrame.LookVector
            local flat=Vector3.new(lv.X,0,lv.Z)
            if flat.Magnitude>0.001 then ceYaw=math.atan2(-flat.Unit.X,-flat.Unit.Z) end
            local fm=Vector3.zero
            if fks[Enum.KeyCode.W] and flat.Magnitude>0 then fm=fm+flat.Unit end
            if fks[Enum.KeyCode.S] and flat.Magnitude>0 then fm=fm-flat.Unit end
            local rv=cam.CFrame.RightVector; local frv=Vector3.new(rv.X,0,rv.Z)
            if fks[Enum.KeyCode.A] and frv.Magnitude>0 then fm=fm-frv.Unit end
            if fks[Enum.KeyCode.D] and frv.Magnitude>0 then fm=fm+frv.Unit end
            local nx,nz=hrp2.Position.X,hrp2.Position.Z
            if fm.Magnitude>0.05 then
                fm=fm.Unit; nx=nx+fm.X*HumSettings.WalkSpeed*math.min(dt,0.033333)
                nz=nz+fm.Z*HumSettings.WalkSpeed*math.min(dt,0.033333)
            end
            local rp2=RaycastParams.new(); rp2.FilterType=Enum.RaycastFilterType.Exclude
            rp2.FilterDescendantsInstances={c}
            local res2=workspace:Raycast(Vector3.new(nx,hrp2.Position.Y+2,nz),Vector3.new(0,100,0),rp2)
            local topY=res2 and res2.Position.Y-3 or hrp2.Position.Y+3
            pcall(function()
                hrp2.CFrame=CFrame.new(nx,topY,nz)*CFrame.Angles(math.rad(180),ceYaw,0)
                hrp2.AssemblyLinearVelocity=Vector3.zero; hrp2.AssemblyAngularVelocity=Vector3.zero
            end)
        end)
    end

    -- SIDEWALK
    function stopSide()
        Mv.side=false
        if Mv.sConn then Mv.sConn:Disconnect(); Mv.sConn=nil end
        if sideAnimTrack then pcall(function() sideAnimTrack:Stop(); sideAnimTrack:Destroy() end); sideAnimTrack=nil end
        RunService:UnbindFromRenderStep("MiAdmin_SideCamUpright")
        local hrp=getHRP2(); local hum=getHum2()
        if hum then pcall(function() hum.AutoRotate=true; hum.PlatformStand=false end) end
        if hrp then pcall(function()
            local _,ey,_2=hrp.CFrame:ToEulerAnglesYXZ()
            hrp.CFrame=CFrame.new(hrp.Position+Vector3.new(0,2,0))*CFrame.Angles(0,ey,0)
            hrp.AssemblyLinearVelocity=Vector3.zero; hrp.AssemblyAngularVelocity=Vector3.zero
        end) end
        if not FlyCtx.enabled and not Mv.crawl and not Mv.ceil then MovementOverride=false end
    end
    Mv.startSide=function()
        local hum=getHum2(); local hrp=getHRP2(); if not hum or not hrp then return end
        hum.AutoRotate=false; MovementOverride=true
        local _,sYaw,_2=hrp.CFrame:ToEulerAnglesYXZ()
        local animInst=Instance.new("Animation")
        animInst.AnimationId="rbxassetid://"..tostring(hum.RigType==Enum.HumanoidRigType.R15 and 507777826 or 180426354)
        local ok,anim=pcall(function() return hum:LoadAnimation(animInst) end)
        if ok and anim then anim.Priority=Enum.AnimationPriority.Action; anim.Looped=true; sideAnimTrack=anim end
        RunService:UnbindFromRenderStep("MiAdmin_SideCamUpright")
        RunService:BindToRenderStep("MiAdmin_SideCamUpright",Enum.RenderPriority.Camera.Value+1,function()
            if not Mv.side then return end
            local cam2=workspace.CurrentCamera; if not cam2 then return end
            local lv2=cam2.CFrame.LookVector
            if lv2.Magnitude>0.001 then
                cam2.CFrame=CFrame.lookAt(cam2.CFrame.Position,cam2.CFrame.Position+lv2,Vector3.yAxis)
            end
        end)
        Mv.sConn=RunService.Heartbeat:Connect(function(dt)
            if not Mv.side then return end
            local c=LocalPlayer.Character; if not c then return end
            local h2=c:FindFirstChildOfClass("Humanoid"); local hrp2=c:FindFirstChild("HumanoidRootPart")
            if not h2 or not hrp2 then return end
            local cam=workspace.CurrentCamera
            local flat_lv=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
            local flat_rv=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
            local move=Vector3.zero
            if flat_lv.Magnitude>0 then
                if fks[Enum.KeyCode.W] then move=move+flat_lv.Unit end
                if fks[Enum.KeyCode.S] then move=move-flat_lv.Unit end
            end
            if flat_rv.Magnitude>0 then
                if fks[Enum.KeyCode.A] then move=move-flat_rv.Unit end
                if fks[Enum.KeyCode.D] then move=move+flat_rv.Unit end
            end
            local moving=move.Magnitude>0.05
            local nx,nz=hrp2.Position.X,hrp2.Position.Z
            if moving then move=move.Unit; nx=nx+move.X*h2.WalkSpeed*dt; nz=nz+move.Z*h2.WalkSpeed*dt
                sYaw=math.atan2(-move.X,-move.Z) end
            local vel=hrp2.AssemblyLinearVelocity
            local rp3=RaycastParams.new(); rp3.FilterType=Enum.RaycastFilterType.Exclude; rp3.FilterDescendantsInstances={c}
            local res3=workspace:Raycast(Vector3.new(nx,hrp2.Position.Y+3,nz),Vector3.new(0,-100,0),rp3)
            local gY=res3 and res3.Position.Y+1.4 or hrp2.Position.Y-1.4
            local finalY=hrp2.Position.Y
            if h2.FloorMaterial~=Enum.Material.Air and vel.Y<=1 then finalY=gY end
            pcall(function()
                hrp2.CFrame=CFrame.new(nx,finalY,nz)*CFrame.Angles(0,sYaw,0)*CFrame.Angles(math.rad(-90),0,0)
                hrp2.AssemblyLinearVelocity=Vector3.new(move.X*h2.WalkSpeed,vel.Y,move.Z*h2.WalkSpeed)
                hrp2.AssemblyAngularVelocity=Vector3.zero
            end)
            if sideAnimTrack then
                if moving and not sideAnimTrack.IsPlaying then sideAnimTrack:Play(0.1,1,1.2)
                elseif not moving and sideAnimTrack.IsPlaying then sideAnimTrack:Stop(0.1) end
            end
        end)
    end

