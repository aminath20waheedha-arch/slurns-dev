do
    local R6B={{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
    local R15B={
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local function removeSkel(p)
        local data=SkelCtx.objects[p]; if not data then return end
        for _,d in ipairs(data) do if d.adorn then pcall(function() d.adorn:Destroy() end) end end
        SkelCtx.objects[p]=nil
    end
    local function createSkel(p)
        if p==LocalPlayer then return end
        local c=p.Character; if not c then return end
        local hum=c:FindFirstChildOfClass("Humanoid"); if not hum then return end
        removeSkel(p)
        local bones=hum.RigType==Enum.HumanoidRigType.R15 and R15B or R6B
        local data={}
        for _,pair in ipairs(bones) do
            local pA=c:FindFirstChild(pair[1]); local pB=c:FindFirstChild(pair[2])
            if pA and pB and pA:IsA("BasePart") and pB:IsA("BasePart") then
                local adorn=Instance.new("BoxHandleAdornment")
                adorn.Adornee=pA; adorn.AlwaysOnTop=true; adorn.ZIndex=10
                adorn.Color3=Color3.fromRGB(255,255,255); adorn.Transparency=0.1
                adorn.Size=Vector3.new(0.09,0.09,0.1); adorn.Parent=pA
                table.insert(data,{adorn=adorn,pA=pA,pB=pB})
            end
        end
        SkelCtx.objects[p]=data
    end
    function stopSkel()
        SkelCtx.enabled=false
        for p in pairs(SkelCtx.objects) do removeSkel(p) end
    end
    SkelCtx.startFn=function()
        for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then createSkel(p) end end
    end
    RunService.RenderStepped:Connect(function()
        if not SkelCtx.enabled then return end
        for p,data in pairs(SkelCtx.objects) do
            for _,d in ipairs(data) do
                local adorn=d.adorn; local pA=d.pA; local pB=d.pB
                if not adorn or not adorn.Parent or not pA or not pA.Parent or not pB or not pB.Parent then break end
                local mag=(pB.Position-pA.Position).Magnitude
                if mag>0.01 then
                    local cf=CFrame.lookAt((pA.Position+pB.Position)*0.5,pB.Position)
                    adorn.CFrame=pA.CFrame:ToObjectSpace(cf)
                    adorn.Size=Vector3.new(0.09,0.09,mag)
                end
            end
            if not p.Parent then removeSkel(p) end
        end
    end)
    Players.PlayerRemoving:Connect(removeSkel)
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function()
            if SkelCtx.enabled then task.wait(0.5); createSkel(p) end
        end)
    end)
    for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then
        p.CharacterAdded:Connect(function()
            if SkelCtx.enabled then task.wait(0.5); createSkel(p) end
        end)
    end end

