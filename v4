        btn.Activated:Connect(function() if onClick then pcall(onClick) end end)
        table.insert(section.rows,row); return row
    end
    return {addSection=addSection,addCheckbox=addCheckbox,addSlider=addSlider,
        addDropdown=addDropdown,addButton=addButton,relayout=relayout,sections=sections,scroll=scroll}
end

