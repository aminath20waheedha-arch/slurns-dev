    -- FLOAT
    function stopFloat()
        Mv.float=false
        if Mv.fjConn then Mv.fjConn:Disconnect(); Mv.fjConn=nil end
        if Mv.fhConn then Mv.fhConn:Disconnect(); Mv.fhConn=nil end
        if Mv.fForce then Mv.fForce:Destroy(); Mv.fForce=nil end
        if Mv.fAttach then Mv.fAttach:Destroy(); Mv.fAttach=nil end
        Mv.fHeld=false; Mv.fArmed=false; Mv.fY=nil
        local hum=getHum2()
        if hum then pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,true); hum.AutoRotate=true end) end
    end
    Mv.startFloat=function()
        stopFloat()
        local function grabFloat(hum,hrp)
            if Mv.fForce then Mv.fForce:Destroy() end
            if Mv.fAttach then Mv.fAttach:Destroy() end
            Mv.fY=hrp.Position.Y; Mv.fHeld=true
            Mv.fAttach=Instance.new("Attachment"); Mv.fAttach.Parent=hrp
            Mv.fForce=Instance.new("VectorForce"); Mv.fForce.Attachment0=Mv.fAttach
            Mv.fForce.RelativeTo=Enum.ActuatorRelativeTo.World
            Mv.fForce.ApplyAtCenterOfMass=true; Mv.fForce.Parent=hrp
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,false)
            hum:ChangeState(Enum.HumanoidStateType.Running); hum.AutoRotate=false
            hrp.AssemblyLinearVelocity=Vector3.new(hrp.AssemblyLinearVelocity.X,0,hrp.AssemblyLinearVelocity.Z)
        end
        Mv.fjConn=UserInputService.JumpRequest:Connect(function()
            if not Mv.float or FlyCtx.enabled or VFly.enabled then return end
            local hum=getHum2(); local hrp=getHRP2(); if not hum or not hrp then return end
            if Mv.fHeld then
                Mv.fHeld=false; Mv.fArmed=true; Mv.fY=nil
                if Mv.fForce then Mv.fForce:Destroy(); Mv.fForce=nil end
                if Mv.fAttach then Mv.fAttach:Destroy(); Mv.fAttach=nil end
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall,true)
                hrp.AssemblyLinearVelocity=Vector3.new(hrp.AssemblyLinearVelocity.X,HumSettings.JumpPower,hrp.AssemblyLinearVelocity.Z)
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            else Mv.fArmed=true end
        end)
        Mv.fhConn=RunService.Heartbeat:Connect(function()
            if not Mv.float then return end
            local hum=getHum2(); local hrp=getHRP2(); if not hum or not hrp then return end
            if FlyCtx.enabled or VFly.enabled then Mv.fArmed=false; Mv.fHeld=false; return end
            local st=hum:GetState(); local vel=hrp.AssemblyLinearVelocity
            if Mv.fArmed and not Mv.fHeld and vel.Y<=0
                and st~=Enum.HumanoidStateType.Landed and st~=Enum.HumanoidStateType.Running then
                grabFloat(hum,hrp); return
            elseif Mv.fHeld then
                if not Mv.fForce or not Mv.fForce.Parent then grabFloat(hum,hrp); return end
                Mv.fForce.Force=Vector3.new(0,hrp.AssemblyMass*workspace.Gravity,0)
                if hum:GetState()~=Enum.HumanoidStateType.Running then hum:ChangeState(Enum.HumanoidStateType.Running) end
                local md=hum.MoveDirection; local dy=0
                if Mv.fY then local diff=Mv.fY-hrp.Position.Y; if math.abs(diff)>0.15 then dy=math.clamp(diff*8,-6,6) end end
                hrp.AssemblyLinearVelocity=Vector3.new(md.X*hum.WalkSpeed,dy,md.Z*hum.WalkSpeed)
                hrp.AssemblyAngularVelocity=Vector3.zero
            elseif st==Enum.HumanoidStateType.Landed then Mv.fArmed=false; Mv.fY=nil end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.3)
        if Mv.crawl then local s=Mv.crawl; stopCrawl(); Mv.crawl=s; if Mv.crawl then Mv.startCrawl() end end
        if Mv.ceil then local s=Mv.ceil; stopCeiling(); Mv.ceil=s; if Mv.ceil then Mv.startCeiling() end end
        if Mv.side then local s=Mv.side; stopSide(); Mv.side=s; if Mv.side then Mv.startSide() end end
        if Mv.ijump then local s=Mv.ijump; stopIJump(); Mv.ijump=s; if Mv.ijump then Mv.startIJump() end end
    end)
end -- MOVEMENT do-block

