                            AutoGivePanel=UI.AutoGivePanel,ArrestPanel=UI.ArrestPanel,TracersPanel=UI.TracersPanel,
                            FlyPanel=UI.FlyPanel,MovementPanel=UI.MovementPanel,KillAuraPanel=UI.KillAuraPanel,
                            UtilityPanel=UI.UtilityPanel,CheckpointsPanel=UI.CheckpointsPanel,TrollPanel=UI.TrollPanel}
