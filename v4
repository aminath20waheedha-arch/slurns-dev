        PlaceholderText="name...",PlaceholderColor3=col.dim,Text="",TextSize=8,
        TextColor3=col.white,ClearTextOnFocus=false,Parent=tpSaveInputRow.frame},
        {squareCorner(2),create("UIStroke",{Color=col.inputStroke,Thickness=0.6})})
    local tpSaveBtn=create("TextButton",{Size=UDim2.new(0.35,0,0,14),Position=UDim2.new(0.65,2,0,1),
        BackgroundColor3=col.buttonBg,BorderSizePixel=0,Font=Enum.Font.Code,Text="save",TextSize=8,
        TextColor3=col.green,Parent=tpSaveInputRow.frame},
        {squareCorner(2),create("UIStroke",{Color=col.buttonStroke,Thickness=0.6})})
    table.insert(tpSaved.rows,tpSaveInputRow)
    local savedListRow={}; savedListRow._isSavedList=true
    savedListRow.frame=create("Frame",{BackgroundTransparency=1,Parent=tpSaved.frame})
    savedListRow.dynamicH=function() return 16 end
    table.insert(tpSaved.rows,savedListRow)
    local function RefreshSavedLocationsList()
        for _,row in ipairs(tpSaved.rows) do
            if row._isSavedList then
                for _,ch in ipairs(row.frame:GetChildren()) do ch:Destroy() end
                local names={}; for n in pairs(SavedLocations) do table.insert(names,n) end; table.sort(names)
                local rowH,gap=16,2; local total=math.max(rowH,#names*(rowH+gap))
                row.frame.Size=UDim2.fromOffset(tpInnerW-8,total); row.dynamicH=function() return total end
                if #names==0 then
                    create("TextLabel",{Size=UDim2.new(1,0,0,rowH),BackgroundTransparency=1,Font=Enum.Font.Code,
                        Text="no saved locations",TextSize=8,TextColor3=col.dim,Parent=row.frame})
                else
                    for i,name in ipairs(names) do
                        local posT=SavedLocations[name]; local y=(i-1)*(rowH+gap)
                        local ef=create("Frame",{Position=UDim2.fromOffset(0,y),Size=UDim2.fromOffset(tpInnerW-8,rowH),BackgroundTransparency=1,Parent=row.frame})
                        create("TextLabel",{Size=UDim2.new(0.55,0,1,0),BackgroundTransparency=1,Font=Enum.Font.Code,
                            Text=name,TextSize=8,TextColor3=col.white,TextXAlignment=Enum.TextXAlignment.Left,Parent=ef})
                        local goBtn=create("TextButton",{Size=UDim2.new(0.22,0,0,rowH-2),Position=UDim2.new(0.56,0,0,1),
                            BackgroundColor3=col.buttonBg,BorderSizePixel=0,Font=Enum.Font.Code,Text="go",TextSize=8,TextColor3=col.green,Parent=ef},
                            {squareCorner(2),create("UIStroke",{Color=col.buttonStroke,Thickness=0.6})})
                        local delBtn=create("TextButton",{Size=UDim2.new(0.2,0,0,rowH-2),Position=UDim2.new(0.79,2,0,1),
                            BackgroundColor3=col.inputBg,BorderSizePixel=0,Font=Enum.Font.Code,Text="del",TextSize=8,TextColor3=col.red,Parent=ef},
                            {squareCorner(2),create("UIStroke",{Color=col.red,Thickness=0.6})})
                        goBtn.Activated:Connect(function() if posT then TeleportTo(Vector3.new(posT.X,posT.Y,posT.Z)); Notify("TP","→ "..name) end end)
                        delBtn.Activated:Connect(function() SavedLocations[name]=nil; SaveLocations(); Notify("TP","Deleted '"..name.."'"); RefreshSavedLocationsList() end)
                    end
                end
                tpUI.relayout(); return
            end
        end
    end
    tpSaveBtn.Activated:Connect(function()
        local name=tpInput.Text:gsub("^%s+",""):gsub("%s+$","")
        if name=="" then Notify("TP","Enter a name."); return end
        local pos=GetCurrentPos(); if not pos then Notify("TP","No character."); return end
        SavedLocations[name]={X=pos.X,Y=pos.Y,Z=pos.Z}; SaveLocations(); tpInput.Text=""
        Notify("TP","Saved '"..name.."'"); RefreshSavedLocationsList()
    end)
    RefreshSavedLocationsList(); tpUI.relayout()
end

------------------------------------------------------------------ GOTO PANEL
do
    local GOTO_W,GOTO_HEAD,GOTO_BODY=170,15,160; local gotoInnerW=GOTO_W-12-4
    UI.GotoPanel=createPanel({name="MiAdminGoto",title="GO-TO PLAYERS",width=GOTO_W,headH=GOTO_HEAD,bodyH=GOTO_BODY,
        position=UDim2.fromScale(0.86,0.5),binary=CONFIG.helpBinary,onMin=function() end})
    UI.GotoPanel.binary.setInner(GOTO_BODY)
    local gotoUI=buildPanelContent(UI.GotoPanel,gotoInnerW,GOTO_BODY)
    local RoleFilter={Guard=true,Inmate=true,Criminal=true,Neutral=true,Unknown=true}
    local filterRoles={"Guard","Inmate","Criminal","Neutral","Unknown"}
    local roleColors2={Guard=col.blue,Inmate=col.orange,Criminal=col.crimson,Neutral=col.neutral,Unknown=Color3.fromRGB(180,180,190)}
    local gotoFilterSec=gotoUI.addSection("FILTER",true)
    local gotoFilterRow={}; gotoFilterRow.frame=create("Frame",{BackgroundTransparency=1,Parent=gotoFilterSec.frame})
    local gotoPlayersSec=gotoUI.addSection("PLAYERS",true)
    local gotoListRow={}; gotoListRow.frame=create("Frame",{BackgroundTransparency=1,Parent=gotoPlayersSec.frame})
    gotoListRow.dynamicH=function() return gotoListRow._h or 16 end
    local gotoRefreshRef
    local function RefreshGotoList()
        for _,ch in ipairs(gotoListRow.frame:GetChildren()) do ch:Destroy() end
        local myRoot=GetMyRoot(); local myPos=myRoot and myRoot.Position or Vector3.zero
        local groups={Guard={},Inmate={},Criminal={},Neutral={},Unknown={}}
        for _,p in ipairs(cachedPlayersList) do
            if p~=LocalPlayer and p.Parent then
                local char,root=GetCharacter(p)
                if char and root then
                    local role=DetectRole(p); if not groups[role] then role="Unknown" end
                    local dist=(root.Position-myPos).Magnitude
                    table.insert(groups[role],{player=p,dist=dist})
                end
            end
        end
        local ROW,GAP2=17,2; local y=0; local anyVisible=false
        for _,roleName in ipairs(filterRoles) do
            if RoleFilter[roleName] then
                local list=groups[roleName]
                if list and #list>0 then
                    anyVisible=true; table.sort(list,function(a,b) return a.dist<b.dist end)
                    local hdrF=create("Frame",{Position=UDim2.fromOffset(0,y),Size=UDim2.fromOffset(gotoInnerW-8,12),BackgroundTransparency=1,Parent=gotoListRow.frame})
                    create("TextLabel",{Size=UDim2.fromScale(1,1),Position=UDim2.fromOffset(2,0),BackgroundTransparency=1,Font=Enum.Font.Code,
                        Text=roleName:upper().." ("..#list..")",TextSize=8,TextColor3=roleColors2[roleName],TextXAlignment=Enum.TextXAlignment.Left,Parent=hdrF})
                    y=y+14
                    for _,entry in ipairs(list) do
                        local p=entry.player; local dist=math.floor(entry.dist)
                        local entryF=create("Frame",{Position=UDim2.fromOffset(0,y),Size=UDim2.fromOffset(gotoInnerW-8,ROW),
                            BackgroundColor3=col.inputBg,BorderSizePixel=0,Parent=gotoListRow.frame},
                            {squareCorner(3),create("UIStroke",{Color=col.inputStroke,Thickness=0.6})})
                        create("Frame",{Size=UDim2.fromOffset(2,ROW-4),Position=UDim2.fromOffset(2,2),
                            BackgroundColor3=roleColors2[roleName],BorderSizePixel=0,Parent=entryF},{squareCorner(1)})
                        create("TextLabel",{Size=UDim2.new(0.55,0,0,10),Position=UDim2.fromOffset(8,1),BackgroundTransparency=1,Font=Enum.Font.Code,
                            Text=p.DisplayName or p.Name,TextSize=8,TextColor3=roleColors2[roleName],TextXAlignment=Enum.TextXAlignment.Left,Parent=entryF})
                        create("TextLabel",{Size=UDim2.new(0.55,0,0,8),Position=UDim2.fromOffset(8,9),BackgroundTransparency=1,Font=Enum.Font.Code,
                            Text="@"..p.Name.."  "..dist.."st",TextSize=7,TextColor3=col.dim,TextXAlignment=Enum.TextXAlignment.Left,Parent=entryF})
                        local goBtn=create("TextButton",{Size=UDim2.new(0.38,0,0,ROW-4),AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-2,0.5,0),
                            BackgroundColor3=roleColors2[roleName],BorderSizePixel=0,Font=Enum.Font.Code,Text="GOTO",TextSize=8,TextColor3=col.black,Parent=entryF},{squareCorner(2)})
                        goBtn.Activated:Connect(function()
                            local char2,root2=GetCharacter(p)
                            if char2 and root2 then TeleportTo(root2.Position+Vector3.new(0,0,3)); Notify("GOTO","→ "..(p.DisplayName or p.Name))
                            else Notify("GOTO","No character.") end
                        end)
                        y=y+ROW+GAP2
                    end
                end
            end
        end
        if not anyVisible then
            create("TextLabel",{Size=UDim2.fromOffset(gotoInnerW-8,16),BackgroundTransparency=1,Font=Enum.Font.Code,
                Text="no players found",TextSize=8,TextColor3=col.dim,Parent=gotoListRow.frame}); y=16
        end
        gotoListRow._h=y; gotoUI.relayout()
    end
    gotoRefreshRef=RefreshGotoList
    for i,roleName in ipairs(filterRoles) do
        local btn=create("TextButton",{
            Position=UDim2.fromOffset((i-1)*((gotoInnerW-8)/5)+1,0),
            Size=UDim2.fromOffset(math.floor((gotoInnerW-8)/5)-2,12),
            BackgroundColor3=roleColors2[roleName],BackgroundTransparency=0.3,
            BorderSizePixel=0,Font=Enum.Font.Code,Text=roleName:sub(1,3),TextSize=7,TextColor3=col.white,Parent=gotoFilterRow.frame},
            {squareCorner(2)})
        btn.Activated:Connect(function()
            RoleFilter[roleName]=not RoleFilter[roleName]
            btn.BackgroundTransparency=RoleFilter[roleName] and 0.3 or 0.8
            pcall(gotoRefreshRef)
        end)
    end
    table.insert(gotoFilterSec.rows,gotoFilterRow)
    table.insert(gotoPlayersSec.rows,gotoListRow)
    gotoUI.relayout()
    task.spawn(function()
        while true do task.wait(2)
            if UI.GotoPanel and UI.GotoPanel.state=="open" then pcall(gotoRefreshRef) end
        end
    end)
    RefreshGotoList()
