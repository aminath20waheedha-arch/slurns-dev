    local function execute(raw)
        raw=raw:gsub("^[:;!/]","")
        local args={}; for word in raw:gmatch("%S+") do table.insert(args,word) end
        local name=table.remove(args,1); if not name then return bad("no command") end
        local cmd=aliasMap[name:lower()]; if not cmd then return bad("command not found",name:lower()) end
        local okRun,a,b=pcall(cmd.run,args); if not okRun then return bad("command errored") end
        return a,b
    end
    InputBox.FocusLost:Connect(function(enterPressed)
        tween(InputFrame,0.2,{BackgroundColor3=col.inputBg})
        if not enterPressed then return end
        local text=InputBox.Text:match("^%s*(.-)%s*$")
        if text=="" then
            InputStroke.Color=col.red; UI.MainPanel.binary.flash("bad")
        else
            local success,segs=execute(text)
            InputStroke.Color=success and col.green or col.red
            UI.MainPanel.binary.flash(success and "good" or "bad")
            Debug.show(segs,not success)
            if success then InputBox.Text="" end
        end
        tween(InputStroke,0.6,{Color=col.inputStroke})
    end)
