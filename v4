------------------------------------------------------------------ main loops
local lastESP,lastNCScan,lastNCEnforce,lastHum=0,0,0,0
RunService.Heartbeat:Connect(function()
    local now=tick()
    if now-lastESP>=0.1 then lastESP=now; if ESPSettings.Enabled then RefreshESP() end end
    if NoclipSettings.Enabled then
        if now-lastNCScan>=0.75 then lastNCScan=now; NoclipScan() end
        if now-lastNCEnforce>=0.2 then lastNCEnforce=now; NoclipEnforce() end
    end
    if now-lastHum>=0.1 then lastHum=now; ApplyHumanoid() end
    for p,cache in pairs(CharCache) do
        if not p.Parent then cache.Char,cache.Root,cache.Humanoid=nil,nil,nil; CharCache[p]=nil
        elseif cache.Char and not cache.Char.Parent then cache.Char,cache.Root,cache.Humanoid=nil,nil,nil end
    end
end)
RunService.RenderStepped:Connect(function()
    UpdateESP2D()
    if TracerSettings.Enabled then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then UpdateTracer(p) end
        end
    else for p in pairs(tracerBeams) do RemoveTracer(p) end end
end)
task.spawn(function()
    while true do task.wait(0.5)
        if HitboxSettings.Enabled then
            for _,p in ipairs(Players:GetPlayers()) do
                local char6=p.Character; local hrp6=char6 and char6:FindFirstChild("HumanoidRootPart")
                if hrp6 and math.abs(hrp6.Size.X-HitboxSettings.Size)>0.1 then HitboxApplyChar(char6) end
            end
        end
    end
end)

