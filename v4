    arrUI.addSlider(arrSettSec,"stick distance",function() return ArrSettings.StickDistance end,function(v) ArrSettings.StickDistance=v end,0.5,20,0.5)
    arrUI.addSlider(arrSettSec,"stick height",function() return ArrSettings.StickHeight end,function(v) ArrSettings.StickHeight=v end,-5,10,0.5)
    arrUI.addSlider(arrSettSec,"stick duration",function() return ArrSettings.StickDuration end,function(v) ArrSettings.StickDuration=v end,0.5,60,0.5)
    local arrCrimSec=arrUI.addSection("CRIMINALS")
    local arrListRow={}; arrListRow.frame=create("Frame",{BackgroundTransparency=1,Parent=arrCrimSec.frame})
    arrListRow.dynamicH=function() return arrListRow._h or 16 end
    RefreshArrestList=function()
        for _,ch in ipairs(arrListRow.frame:GetChildren()) do ch:Destroy() end
        local isGuard=IsLocalGuard()
        if not isGuard then
            arrStatusLbl.Text="not a guard"; arrStatusLbl.TextColor3=col.red
            create("TextLabel",{Size=UDim2.fromOffset(arrInnerW-8,16),BackgroundTransparency=1,
                Font=Enum.Font.Code,Text="join guards to use arrest",TextSize=8,TextColor3=col.dim,Parent=arrListRow.frame})
            arrListRow._h=16; arrUI.relayout(); return
        end
        local hasCuffs=false
        local bp=LocalPlayer:FindFirstChild("Backpack"); local char3=LocalPlayer.Character
        if bp and bp:FindFirstChild(ArrSettings.ToolName) then hasCuffs=true end
        if char3 and char3:FindFirstChild(ArrSettings.ToolName) then hasCuffs=true end
        local criminals=GetCriminalsList()
        arrStatusLbl.Text=(hasCuffs and "\u{2713} guard | cuffs ready | " or "\u{26A0} no cuffs | ")..#criminals.." criminal(s)"
        arrStatusLbl.TextColor3=hasCuffs and col.green or col.orange
        local ROW,GAP2,y=20,2,0
        if #criminals==0 then
            create("TextLabel",{Size=UDim2.fromOffset(arrInnerW-8,16),BackgroundTransparency=1,
                Font=Enum.Font.Code,Text="no criminals",TextSize=8,TextColor3=col.dim,Parent=arrListRow.frame}); y=16
        else
            for _,data in ipairs(criminals) do
                local p=data.player; local dist=math.floor(data.dist)
                local entryF=create("Frame",{Position=UDim2.fromOffset(0,y),Size=UDim2.fromOffset(arrInnerW-8,ROW),
                    BackgroundColor3=col.inputBg,BorderSizePixel=0,Parent=arrListRow.frame},
                    {squareCorner(3),create("UIStroke",{Color=col.crimson,Thickness=0.5})})
                create("TextLabel",{Size=UDim2.new(0.55,0,0,11),Position=UDim2.fromOffset(6,1),BackgroundTransparency=1,
                    Font=Enum.Font.Code,Text=p.DisplayName or p.Name,TextSize=8,TextColor3=col.crimson,TextXAlignment=Enum.TextXAlignment.Left,Parent=entryF})
                create("TextLabel",{Size=UDim2.new(0.55,0,0,9),Position=UDim2.fromOffset(6,11),BackgroundTransparency=1,
                    Font=Enum.Font.Code,Text=dist.." studs",TextSize=7,TextColor3=col.dim,TextXAlignment=Enum.TextXAlignment.Left,Parent=entryF})
                local stickBtn=create("TextButton",{Size=UDim2.new(0.38,0,0,ROW-4),AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-2,0.5,0),
                    BackgroundColor3=Color3.fromRGB(80,20,20),BorderSizePixel=0,Font=Enum.Font.Code,Text="STICK",TextSize=8,TextColor3=col.red,
                    Parent=entryF},{squareCorner(2),create("UIStroke",{Color=col.red,Thickness=0.5})})
                stickBtn.Activated:Connect(function()
                    if not ArrSettings.Enabled then Notify("Arrest","Enable arrest first."); return end
                    if not IsLocalGuard() then Notify("Arrest","Must be a guard."); return end
                    if ArrestState.Running then StopArrest(ArrestState.HomeCFrame) end
                    task.spawn(function() ArrestPlayer(p) end)
                end)
                y=y+ROW+GAP2
            end
        end
        arrListRow._h=y; arrUI.relayout()
    end
    table.insert(arrCrimSec.rows,arrListRow)
    local arrActSec=arrUI.addSection("ACTIONS")
    arrUI.addButton(arrActSec,"stop sticking",function() StopArrest(ArrestState.HomeCFrame); Notify("Arrest","Stopped.") end)
    arrUI.addButton(arrActSec,"refresh list",function() RefreshArrestList() end)
    arrUI.relayout()
    task.spawn(function()
        while true do task.wait(2)
            if UI.ArrestPanel and UI.ArrestPanel.state=="open" then pcall(RefreshArrestList) end
        end
    end)
end

