do
    local function getWeaponTool()
        local c=LocalPlayer.Character; if not c then return nil end
        for _,v in ipairs(c:GetChildren()) do if v:IsA("Tool") then return v end end
        local bp=LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp then for _,v in ipairs(bp:GetChildren()) do if v:IsA("Tool") then return v end end end
        return nil
    end
    local function getNearestInRange(range)
        local c=LocalPlayer.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
        local best,bestDist=nil,range
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer then
                local pc=p.Character; local ph=pc and pc:FindFirstChildOfClass("Humanoid")
                local phrp=pc and pc:FindFirstChild("HumanoidRootPart")
                if phrp and ph and ph.Health>0 then
                    local d=(phrp.Position-hrp.Position).Magnitude
                    if d<bestDist then bestDist=d; best=p end
                end
            end
        end
        return best
    end
    function stopKA()
        KA.enabled=false
        if KA.conn then KA.conn:Disconnect(); KA.conn=nil end
    end
    KA.startFn=function()
        stopKA(); KA.acc=0
        KA.conn=RunService.Heartbeat:Connect(function(dt)
            if not KA.enabled then return end
            KA.acc=KA.acc+dt; if KA.acc<0.25 then return end; KA.acc=0
            local target=getNearestInRange(KA.range); if not target then return end
            local c=LocalPlayer.Character; local hum=c and c:FindFirstChildOfClass("Humanoid")
            local hrp=c and c:FindFirstChild("HumanoidRootPart")
            local tchar=target.Character; local thrp=tchar and tchar:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp or not thrp or hum.Health<=0 then return end
            local tool=getWeaponTool(); if not tool then return end
            if tool.Parent~=c then hum:EquipTool(tool); return end
            local aimP=Vector3.new(thrp.Position.X,hrp.Position.Y,thrp.Position.Z)
            if (aimP-hrp.Position).Magnitude>0.1 then hrp.CFrame=CFrame.lookAt(hrp.Position,aimP) end
            tool:Activate()
        end)
    end
    -- Fullbright
    MiscSt.startFb=function()
        if not next(MiscSt.fbOrig) then
            for _,k in ipairs({"Brightness","ClockTime","FogEnd","GlobalShadows","OutdoorAmbient","Ambient"}) do
                MiscSt.fbOrig[k]=Lighting[k]
            end
        end
        Lighting.Brightness=2; Lighting.ClockTime=14; Lighting.FogEnd=100000
        Lighting.GlobalShadows=false; Lighting.OutdoorAmbient=Color3.fromRGB(200,200,200); Lighting.Ambient=Color3.fromRGB(200,200,200)
    end
    MiscSt.stopFb=function()
        MiscSt.fb=false
        for k,v in pairs(MiscSt.fbOrig) do Lighting[k]=v end
    end
    RunService:BindToRenderStep("MiAdmin_Fullbright",Enum.RenderPriority.Last.Value,function()
        if MiscSt.fb then MiscSt.startFb() end
    end)
    -- Anti-fling
    local afh,afr,afLastPos
    MiscSt.startAf=function()
        afLastPos=nil
        if afh then afh:Disconnect() end; if afr then afr:Disconnect() end
        afh=RunService.Heartbeat:Connect(function()
            if not MiscSt.afling then return end
            local c=LocalPlayer.Character; local hrp=c and c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            if hrp.AssemblyLinearVelocity.Magnitude>200 then hrp.AssemblyLinearVelocity=Vector3.zero end
            if hrp.AssemblyAngularVelocity.Magnitude>100 then hrp.AssemblyAngularVelocity=Vector3.zero end
            if afLastPos and (hrp.Position-afLastPos).Magnitude>80 then
                pcall(function() hrp.CFrame=CFrame.new(afLastPos) end)
            end
            afLastPos=hrp.Position
        end)
        afr=RunService.RenderStepped:Connect(function()
            if not MiscSt.afling then return end
