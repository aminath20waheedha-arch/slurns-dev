            if hrp.AssemblyLinearVelocity.Magnitude>300 then hrp.AssemblyLinearVelocity=Vector3.zero end
        end)
        table.insert(MiscSt.afConns,afh); table.insert(MiscSt.afConns,afr)
    end
    MiscSt.stopAf=function()
        MiscSt.afling=false
        for _,c in ipairs(MiscSt.afConns) do if c then pcall(function() c:Disconnect() end) end end
        table.clear(MiscSt.afConns); afLastPos=nil
    end
    -- Anti-AFK
    MiscSt.startAfk=function()
        MiscSt.afkConn=LocalPlayer.Idled:Connect(function()
            if not MiscSt.aafk then return end
            pcall(function() VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end)
        end)
    end
    MiscSt.stopAfk=function()
        MiscSt.aafk=false
        if MiscSt.afkConn then MiscSt.afkConn:Disconnect(); MiscSt.afkConn=nil end
    end
