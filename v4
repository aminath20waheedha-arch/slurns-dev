    defineCommand({name="loadconfig",category="misc",description="load config",usage="loadconfig",
        run=function()
            local ok,err=pcall(function()
                if not isfile(CONFIG_FILE) then return end
                local decoded=HttpService:JSONDecode(readfile(CONFIG_FILE)); if not decoded then return end
                local settTbls={SilentAimSettings=Settings,ESPSettings=ESPSettings,HitboxSettings=HitboxSettings,
                    NoclipSettings=NoclipSettings,HumanoidSettings=HumSettings,AutoGiveSettings=AGSettings,
                    ArrestSettings=ArrSettings,TracerSettings=TracerSettings}
                for name,tbl in pairs(settTbls) do
                    local saved=decoded[name]
                    if saved and type(saved)=="table" then
                        for k,v in pairs(saved) do
                            if type(v)=="table" then
                                if v.__Color then tbl[k]=Color3.new(v.r,v.g,v.b)
                                elseif type(tbl[k])=="table" then
                                    for sk,sv in pairs(v) do
                                        if type(sv)=="table" and sv.__Color then tbl[k][sk]=Color3.new(sv.r,sv.g,sv.b)
                                        else tbl[k][sk]=sv end
                                    end
                                end
                            else tbl[k]=v end
                        end
                    end
                end
                if decoded.V3 then
                    local v3=decoded.V3
                    if v3.FlySpeed then FlyCtx.speed=v3.FlySpeed end
                    if v3.VFlySpeed then VFly.speed=v3.VFlySpeed end
                    if v3.FCamSpeed then FCam.speed=v3.FCamSpeed end
                    if v3.KARange then KA.range=v3.KARange end
                    if v3.Fullbright~=nil then MiscSt.fb=v3.Fullbright; if MiscSt.fb then MiscSt.startFb() end end
                    if v3.AntiFling~=nil then MiscSt.afling=v3.AntiFling; if MiscSt.afling then MiscSt.startAf() end end
                    if v3.AntiAFK~=nil then MiscSt.aafk=v3.AntiAFK; if MiscSt.aafk then MiscSt.startAfk() end end
                    if v3.AutoEscape~=nil then Cp.escape=v3.AutoEscape end
                end
                if decoded.UI then
                    task.delay(0.5,function()
                        local panelRefs={MainPanel=UI.MainPanel,HelpPanel=UI.HelpPanel,SilentAimPanel=UI.SilentAimPanel,
                            ESPPanel=UI.ESPPanel,HitboxPanel=UI.HitboxPanel,NoclipPanel=UI.NoclipPanel,
